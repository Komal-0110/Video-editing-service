generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Video {
  id               String   @id @default(uuid())
  name             String
  originalPath     String   
  finalPath        String?
  duration         Int?
  size             Int?
  status           VideoStatus @default(PENDING)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  editedPath       String?

  trimmedStartTime Int?
  trimmedEndTime   Int?
  subtitles        Json?
}

enum VideoStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id        Int      @id @default(autoincrement())
  ext_id    String   @default(uuid())
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  USER
  ADMIN
}